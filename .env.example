# Optional. The app runs fully without any of these — prayer times, Qibla and the
# Quran are computed or bundled on the device. These only power the usage-reporting
# and accuracy-audit endpoints under api/, and Vercel injects them in production.
#
#   cp .env.example .env.local

# Supabase project that holds the miqat_ tables.
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (anon) key. RLS is on with no policies, so this key alone reads and
# writes nothing; every call goes through one security-definer function.
SUPABASE_ANON_KEY=your-supabase-publishable-key

# Shared secret the definer function checks. Requests without it are ignored, which
# is what stops anyone forging rows against Supabase directly.
MIQAT_SERVER_SECRET=generate-a-long-random-string

# Salt for hashing caller IPs before they are used for rate limiting. Raw IPs are
# never stored. Defaults to "miqat" if unset; set it to something unguessable.
MIQAT_IP_SALT=generate-another-random-string

# Guards the manual/cron trigger of the daily accuracy audit.
CRON_SECRET=generate-a-third-random-string

# Optional. Where the audit posts when the published timetable drifts from the maths.
ALERT_WEBHOOK_URL=
